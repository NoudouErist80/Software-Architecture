# Stop Lombok from searching parent directories beyond the project root.
config.stopBubbling = true

# Add @lombok.Generated to all Lombok-generated members (getters, setters,
# builders, equals/hashCode, constructors). JaCoCo 0.8+ automatically EXCLUDES
# anything annotated @Generated from coverage — so boilerplate on DTOs/entities
# doesn't count against the coverage target. You only need tests for real logic.
lombok.addLombokGeneratedAnnotation = true
